BOT_TOKEN=your_token_from_botfather
HELIUS_API_KEY=your_helius_key_optional
# optional: unlocks natural-language query parsing (any phrasing).
# without either key the bot uses the built-in pattern parser.
# cheapest option — platform.deepseek.com (~$0.0001 per message):
DEEPSEEK_API_KEY=your_deepseek_key_optional
# or Claude — console.anthropic.com (schema-guaranteed output):
# ANTHROPIC_API_KEY=your_anthropic_key_optional
# both keys set? force one: INTENT_PROVIDER=deepseek|claude
# override the chosen provider's model:
# INTENT_MODEL=deepseek-chat        (deepseek default)
# INTENT_MODEL=claude-opus-4-8      (claude default)
